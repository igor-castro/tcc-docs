TERMOHIGROMETRO-MIB DEFINITIONS ::= BEGIN

-- MIB do termo-higrometro (temperatura e umidade).
-- Ramo privado: iso.org.dod.internet.private.enterprises.67727
-- OIDs numericos:
--   1.3.6.1.4.1.67727.1.1.0  thTemperature (decimos de grau Celsius)
--   1.3.6.1.4.1.67727.1.2.0  thHumidity    (decimos de porcento)

IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, Integer32, enterprises
        FROM SNMPv2-SMI
    MODULE-COMPLIANCE, OBJECT-GROUP
        FROM SNMPv2-CONF;

termoHigrometroMIB MODULE-IDENTITY
    LAST-UPDATED "202611180000Z"
    ORGANIZATION "Igor Castro"
    CONTACT-INFO
        "Igor Castro
         E-mail: castrig@proton.me"
    DESCRIPTION
        "MIB para consulta de temperatura e umidade relativa
         medidas por um termo-higrometro."
    REVISION "202611180000Z"
    DESCRIPTION
        "Versao inicial."
    ::= { enterprises 67727 }

-- Estrutura da arvore

thObjects      OBJECT IDENTIFIER ::= { termoHigrometroMIB 1 }
thConformance  OBJECT IDENTIFIER ::= { termoHigrometroMIB 2 }

-- Objetos (escalares: a instancia termina em .0)

thTemperature OBJECT-TYPE
    SYNTAX      Integer32 (-550..1250)
    UNITS       "0.1 degrees Celsius"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Temperatura medida, em decimos de grau Celsius.
         Exemplo: o valor 253 corresponde a 25,3 graus Celsius."
    ::= { thObjects 1 }

thHumidity OBJECT-TYPE
    SYNTAX      Integer32 (0..1000)
    UNITS       "0.1 percent"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Umidade relativa do ar, em decimos de porcento.
         Exemplo: o valor 605 corresponde a 60,5 por cento."
    ::= { thObjects 2 }

-- Conformidade

thCompliances  OBJECT IDENTIFIER ::= { thConformance 1 }
thGroups       OBJECT IDENTIFIER ::= { thConformance 2 }

thMeasurementGroup OBJECT-GROUP
    OBJECTS     { thTemperature, thHumidity }
    STATUS      current
    DESCRIPTION
        "Objetos de medicao do termo-higrometro."
    ::= { thGroups 1 }

thCompliance MODULE-COMPLIANCE
    STATUS      current
    DESCRIPTION
        "Requisitos de conformidade para agentes que implementam
         esta MIB."
    MODULE -- este modulo
        MANDATORY-GROUPS { thMeasurementGroup }
    ::= { thCompliances 1 }

END
